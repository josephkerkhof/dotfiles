[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	editor = nvim
[push]
	autoSetupRemote = true
[user]
	useConfigOnly = true
[include]
	path = ~/.gitconfig.local
[includeIf "gitdir:~/code/ae/"]
	path = ~/.gitconfig-ae.local
